{
    "name": "elig45/bagisto-laposte-shipping",
    "description": "La Poste Lettre verte suivie carrier with global weight-based pricing for Bagisto 2.4",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "elig-45"
        }
    ],
    "require": {
        "php": ">=8.3 <8.5",
        "illuminate/support": "^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "orchestra/testbench": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Elig45\\LaPosteShipping\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Elig45\\LaPosteShipping\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Elig45\\LaPosteShipping\\Providers\\LaPosteShippingServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
